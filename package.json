  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/batbayar-su/bagi.mn.git"
  },
  "scripts": {
    "dev": "npm run compile-theme -- -w & hugo server",
    "build": "npm run compile-theme & hugo",
    "compile-theme": "NODE_ENV=development npx @tailwindcss/cli -c ./themes/blowfish/tailwind.config.js -i ./themes/blowfish/assets/css/main.css -o ./assets/css/compiled/main.css --jit",
    "update-theme": "git submodule update --remote --recursive && npm run compile-theme"
  }
}
